{
  "name": "instrument-display-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "test:browser": "node tests/browser-check.mjs",
    "test:browser:serial": "node tests/browser-serial-check.mjs",
    "test:browser:photos": "node tests/browser-photo-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^5.0.5"
  }
}
