// Verified against Tang_Mega_NEO_Dock-60K_31004_Schematics.pdf, pages 7 and 10.
IO_LOC "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// Schematic page 7: FPGA_UART.TX -> BL616 USB JTAG/UART bridge.
IO_LOC "UART_TX" U15;
IO_PORT "UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ??? KEY0??ANK9 ??? 1.5V??
// ????????????????????? C19?????C18?????3.3V??
IO_LOC "TTP_SCL" C19;
IO_PORT "TTP_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "TTP_SDO" C18;
IO_PORT "TTP_SDO" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// ?????? WS2812????????? BANK1_J16_IOT102A??
IO_LOC "WS2812_DATA" J16;
IO_PORT "WS2812_DATA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;


// ???KEY1??B13??ANK9??.5V????????????

// USB????????????????????????????????
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb_dp" H13;
IO_PORT "usb_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb_dm" G13;
IO_PORT "usb_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// BLE UART bridge (ESP32-C3-Zero)
IO_LOC "ble_uart_rx" D19;
IO_PORT "ble_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ble_uart_tx" E19;
IO_PORT "ble_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ADC slider filter candidate: physical KEY0 toggles dry/effect.
IO_LOC "key_filter_n" AA13;
IO_PORT "key_filter_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// DFR0553/ADS1115 I2C. C20/D20 are SDRAM PMOD pins in the vendor example;
// remove that PMOD before using these pins. External module pull-ups required.
IO_LOC "adc_scl" C20;
IO_PORT "adc_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_sda" D20;
IO_PORT "adc_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
